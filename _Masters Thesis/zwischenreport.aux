\@writefile{lot}{\contentsline {table}{\numberline {8.1}{\ignorespaces Overview of the three different matching schemes tested for the final jet matching. It shows the success fraction for each resonance parton for \mbox  {$t\bar  {t}H$}\xspace  . The highlighted $\Delta R$ only approach yields the best results and is chosen for the analysis.}}{40}{table.8.1}\protected@file@percent }
\newlabel{tab:results:truth_matching:final_matching_sheme}{{8.1}{40}{Overview of the three different matching schemes tested for the final jet matching. It shows the success fraction for each resonance parton for \ttH . The highlighted $\Delta R$ only approach yields the best results and is chosen for the analysis}{table.8.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.2}{\ignorespaces Overview of the truth matching performance. the first row includes a composition of different \mbox  {$t\bar  {t}$}\xspace  and \mbox  {$t\bar  {t}H$}\xspace  processes. The highlighted second row only includes the targeted semileptonic \mbox  {$t\bar  {t}(H\rightarrow WW^*)$}\xspace  channel. A match is counted as successfully, if all decay particles have a jet matched. If the $H$ does not exist on truth, the event is not counted towards the $H$ or \mbox  {$t\bar  {t}H$}\xspace  column.}}{40}{table.8.2}\protected@file@percent }
\newlabel{tab:results:truth_matching:performance}{{8.2}{40}{Overview of the truth matching performance. the first row includes a composition of different \ttbar and \ttH processes. The highlighted second row only includes the targeted semileptonic \ttHWW channel. A match is counted as successfully, if all decay particles have a jet matched. If the $H$ does not exist on truth, the event is not counted towards the $H$ or \ttH column}{table.8.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.2}SPA-Net}{41}{section.8.2}\protected@file@percent }
