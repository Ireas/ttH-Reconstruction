\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces Overview of \textit  {SPA-Net}\xspace  assignment matrix showing the predicted and true labels. Each column is normalised to unity. The predefined permutations between the untagged light jets are clearly visible.}}{41}{figure.8.1}\protected@file@percent }
\newlabel{fig:results:spanet:assignment_matrix}{{8.1}{41}{Overview of \spanet assignment matrix showing the predicted and true labels. Each column is normalised to unity. The predefined permutations between the untagged light jets are clearly visible}{figure.8.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.3}{\ignorespaces Overview of \textit  {SPA-Net}'s\xspace  particle reconstruction performance. Each particle is counted as correctly assigned when all daughter particles are correctly matched. Swaps within the allowed permutations are also considered as correctly matched. If any particle has no true assignment, it is not counted. The event is considered as correctly assigned if both the \mbox  {$t\bar  {t}$}\xspace  and hadronic $W$ from the $H$-boson are correctly matched. Thus, this is only possible for \mbox  {$t\bar  {t}H$}\xspace  events.}}{42}{table.8.3}\protected@file@percent }
\newlabel{tab:results:spanet:correct_assignment}{{8.3}{42}{Overview of \spanets particle reconstruction performance. Each particle is counted as correctly assigned when all daughter particles are correctly matched. Swaps within the allowed permutations are also considered as correctly matched. If any particle has no true assignment, it is not counted. The event is considered as correctly assigned if both the \ttbar and hadronic $W$ from the $H$-boson are correctly matched. Thus, this is only possible for \ttH events}{table.8.3}{}}
